# Copy to terraform.tfvars and fill in. Only non-sensitive values belong here;
# secrets are set in Secret Manager via the Google Cloud Console.
# CI sets the same inputs via TF_VAR_* from GitHub Actions repository variables.

project_id  = "ampdresume-production"
region      = "us-west1"
domain      = "ampdresume.com"

# owner/name of the GitHub repo allowed to deploy via Workload Identity Federation.
github_repository = "mission-minded-llc/ampdresume"

# Neon organization ID, from Account Settings > Organization settings.
neon_org_id = "org-example-12345678"

# Public by design: this value is inlined into the browser bundle.
sentry_dsn = ""

# Google Tag Manager container ID. CI sets this from the GTM_ID repository
# variable (TF_VAR_gtm_id). Leave empty to disable analytics.
gtm_id = ""

# Turn on once the domain is verified in Google Search Console. On Cloudflare
# Free, grey-cloud the www/apex records Cloud Run reports after apply.
enable_domain_mapping = false
